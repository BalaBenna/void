PORT=3456
NODE_ENV=development

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

BACKEND_URL=http://localhost:3456
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379

# AI Providers (cloud only — no Ollama/local)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GOOGLE_AI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# E2B Cloud Sandbox (optional)
E2B_API_KEY=e2b_...

# Stripe (optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

DESKTOP_PROTOCOL=void

# Code Embeddings (optional, falls back to OPENAI_API_KEY)
VOYAGE_API_KEY=voyage_...

# GitHub Integration (for BugBot, @PR, @issue)
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=whsec_...

# Linear Integration (optional, for @issue)
LINEAR_API_KEY=lin_api_...
